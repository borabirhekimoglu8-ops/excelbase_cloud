# =============================================================================
# Excelbase Operations — .env
# =============================================================================
# Bu dosyayı kopyala:  cp .env.example .env   (Windows: Copy-Item .env.example .env)
# Sonra YALNIZCA işaretli satırları doldur. .env'i asla git'e ekleme.
#
# KAPALI YEREL İSTASYON (Ollama + iş klasörü, KVKK):
#   1) Ollama açık olsun (http://127.0.0.1:11434)
#   2) Aşağıda MODEL adını `ollama list` ile aynı yap
#   3) WORKSTATION_ROOT / DRIVE_AUDIT_ROOT = senin iş klasörün
#   4) .\run.ps1  veya  ./run.sh
#   5) Tarayıcı: http://127.0.0.1:8000
#
# Anahtar üretmek (gerekirse):
#   openssl rand -base64 48     → GATEVISA_DATA_SECRET
#   openssl rand -base64 32     → POSTGRES_PASSWORD (yalnız Docker/Postgres)
#   openssl rand -hex 24        → GATEVISA_BOOTSTRAP_TOKEN (ilk admin)
# =============================================================================


# -----------------------------------------------------------------------------
# 1) AĞ — bu makineye kilitli kalsın
# -----------------------------------------------------------------------------
# 127.0.0.1 = yalnız bu bilgisayar (önerilen / KVKK)
# 0.0.0.0   = LAN veya internete açık (sakın ollama + klasör indeksi ile)
BIND_ADDRESS=127.0.0.1
HOST_PORT=8000


# -----------------------------------------------------------------------------
# 2) ORTAM
# -----------------------------------------------------------------------------
# production = auth zorunlu, güvenli çerez. Kişisel PC için de uygundur.
APP_ENV=production
GATEVISA_REQUIRE_AUTH=1


# -----------------------------------------------------------------------------
# 3) GİZLİLER — run.ps1 / run.sh boşsa GATEVISA_DATA_SECRET'ı kendisi üretir
# -----------------------------------------------------------------------------
# Operasyon verisini şifreler. Sonradan değiştirirsen eski şifreli satırlar
# okunamaz. Boş bırakıp betiğin doldurmasına izin verebilirsin.
GATEVISA_DATA_SECRET=

# İlk yönetici kurulumu (production). Hesap açılınca sil veya döndür.
GATEVISA_BOOTSTRAP_TOKEN=

# Docker/Postgres kullanıyorsan doldur. SQLite (varsayılan run betiği) için gerekmez.
POSTGRES_PASSWORD=
POSTGRES_USER=excelbase
POSTGRES_DB=excelbase


# -----------------------------------------------------------------------------
# 4) ASİSTAN — yerel Ollama (bulut yok)
# -----------------------------------------------------------------------------
# Sağlayıcı: ollama | anthropic | disabled
EXCELBASE_ASSISTANT_PROVIDER=ollama

# `ollama list` çıktısındaki adla BİREBİR aynı olmalı (ör. llama3.2, qwen2.5:14b)
EXCELBASE_ASSISTANT_MODEL=llama3.2

# Yalnız 127.0.0.1 / localhost. Başka host → privacy_mismatch (red)
EXCELBASE_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Ollama kullanırken Anthropic anahtarı GEREKMEZ — boş bırak
ANTHROPIC_API_KEY=

# 0 = asistan erişim kodu ister (önerilen)
# 1 = kod yok; yalnız BIND_ADDRESS=127.0.0.1 veya IP listesi ile güvenli
EXCELBASE_ASSISTANT_OPEN_ACCESS=0

# 0 = salt okunur (önerilen başlangıç)  |  1 = kayıt değiştirebilir
EXCELBASE_ASSISTANT_ALLOW_WRITES=0

# Boş = kısıt yok. Örnek: 127.0.0.1,192.168.1.0/24
EXCELBASE_ASSISTANT_ALLOWED_IPS=

# Doğrudan container/port = 0  |  önde 1 nginx/Caddy = 1
EXCELBASE_ASSISTANT_TRUSTED_PROXY_HOPS=0

# (İsteğe bağlı ince ayar — dokunmasan da olur)
# EXCELBASE_ASSISTANT_ENABLED=1
# EXCELBASE_ASSISTANT_MAX_OUTPUT_TOKENS=1200
# EXCELBASE_ASSISTANT_TIMEOUT_SECONDS=120
# EXCELBASE_ASSISTANT_REQUESTS_PER_MINUTE=6
# EXCELBASE_ASSISTANT_REQUESTS_PER_DAY=100


# -----------------------------------------------------------------------------
# 5) İŞ KLASÖRÜ — katalog + Drive Audit (içerik dışarı çıkmaz)
# -----------------------------------------------------------------------------
# Katalog: dosya adı/yol indeksi. Hücre, PDF gövdesi, JPEG baytı OKUNMAZ.
EXCELBASE_WORKSTATION=1

# Windows örneği:  G:\Drive'ım\Operasyon
# macOS/Linux:     /Users/sen/Operasyon
EXCELBASE_WORKSTATION_ROOT=

# Şablon / sütun boşluğu taraması (yine yalnız başlık satırı; satır verisi yok)
EXCELBASE_DRIVE_AUDIT=1

# Boşsa WORKSTATION_ROOT ile aynı klasörü kullanır (tercihen ikisini de doldur)
EXCELBASE_DRIVE_AUDIT_ROOT=


# -----------------------------------------------------------------------------
# 6) GELİŞTİRME AJANI — varsayılan KAPALI (kod yazan Claude; Anthropic ister)
# -----------------------------------------------------------------------------
EXCELBASE_DEV_AGENT=0
EXCELBASE_DEV_AGENT_MODEL=claude-opus-5
EXCELBASE_DEV_AGENT_MAX_BUDGET_CENTS=500
EXCELBASE_DEV_AGENT_MAX_TURNS=120


# -----------------------------------------------------------------------------
# 7) BULUT CLAUDE'A GEÇMEK İSTERSEN (Render / internet) — şu an KULLANMA
# -----------------------------------------------------------------------------
# EXCELBASE_ASSISTANT_PROVIDER=anthropic
# EXCELBASE_ASSISTANT_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...
# EXCELBASE_WORKSTATION=0
# EXCELBASE_DRIVE_AUDIT=0
# BIND_ADDRESS=0.0.0.0
