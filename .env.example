# Excelbase Operations — deployment configuration.
# Copy to .env and fill in. Never commit the filled-in file.
#
#   cp .env.example .env
#   docker compose up -d --build

# ----------------------------------------------------------------- required
# Postgres password. Generate one: openssl rand -base64 32
POSTGRES_PASSWORD=

# Encrypts stored operational data. Generate one: openssl rand -base64 48
# Changing this later makes existing encrypted rows unreadable.
GATEVISA_DATA_SECRET=

# ------------------------------------------------------------------ Anthropic
# From https://console.anthropic.com/settings/keys — starts with sk-ant-
# Leave empty to run without the assistant; everything else still works.
ANTHROPIC_API_KEY=

# --------------------------------------------------------------------- access
# Where the port is published. 127.0.0.1 = this machine only.
# 0.0.0.0 = reachable from the LAN (or the internet, if the host is exposed).
BIND_ADDRESS=127.0.0.1
HOST_PORT=8000

# First administrator setup. Required while APP_ENV=production; remove after
# the account exists. Generate one: openssl rand -hex 24
GATEVISA_BOOTSTRAP_TOKEN=

# ------------------------------------------------------------------ assistant
# 1 = Sonnet connects with no access code. Only sensible when the deployment
# is already closed some other way (LAN-only bind, or the IP allowlist below).
EXCELBASE_ASSISTANT_OPEN_ACCESS=0

# 1 = Claude may change records, not just read them. Withheld automatically
# while the deployment is open AND unscoped — close one of the two first.
EXCELBASE_ASSISTANT_ALLOW_WRITES=0

# Comma-separated addresses or CIDR ranges allowed to reach the assistant.
# Empty = no network restriction. Example: 85.105.1.7, 192.168.1.0/24
EXCELBASE_ASSISTANT_ALLOWED_IPS=

# How many reverse proxies sit in front of the app. 0 when the container port
# is reached directly (the compose default); 1 behind one nginx/Caddy/Cloudflare
# hop. Getting this wrong makes the IP allowlist read the wrong address.
EXCELBASE_ASSISTANT_TRUSTED_PROXY_HOPS=0

# ------------------------------------------------------------- dev agent
# 1 = a Claude that develops this application from inside it. It works in a
# separate git worktree, so the running app never edits itself, and its work
# only reaches your branch after the test suite passes and you press APPLY.
#
# Refused outright unless the deployment is closed (an access code, or the IP
# allowlist above): an internet-reachable app that can write code is a
# backdoor. Meant for the machine you develop on, not for a shared server.
EXCELBASE_DEV_AGENT=0

# The strongest model, because this one writes code. Cost ceiling per run in
# cents (500 = $5) — enforced by the SDK, not by asking the model to be brief.
EXCELBASE_DEV_AGENT_MODEL=claude-opus-5
EXCELBASE_DEV_AGENT_MAX_BUDGET_CENTS=500
EXCELBASE_DEV_AGENT_MAX_TURNS=120

# ------------------------------------------------------------------ optional
# APP_ENV=production keeps the fail-closed behaviour (auth required, secure
# cookies). Use development only on a machine you control.
APP_ENV=production
GATEVISA_REQUIRE_AUTH=1
EXCELBASE_ASSISTANT_MODEL=claude-sonnet-5
POSTGRES_USER=excelbase
POSTGRES_DB=excelbase
